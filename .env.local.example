# Copy this file to .env.local and fill values on the deployment machine.
# .env.local is ignored by git and is loaded before config values are read.

SILLYTAVERN_HEADLESS_REMOTEAPP_ENABLED=
SILLYTAVERN_HEADLESS_REMOTEAPP_PUBLICURL=
SILLYTAVERN_HEADLESS_REMOTEAPP_PROXYTARGET=

FRP_SERVER_ADDR=
FRP_SERVER_PORT=
FRP_AUTH_TOKEN=
FRP_PROXY_NAME=sillytavern-headless
FRP_LOCAL_IP=127.0.0.1
FRP_LOCAL_PORT=8000
FRP_REMOTE_PORT=
FRP_CONFIG_PATH=frpc.headless.toml
FRP_CLIENT_BIN=
